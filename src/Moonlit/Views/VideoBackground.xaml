<UserControl x:Class="Moonlit.Views.VideoBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black">
    <Grid>
        <!-- Layer 0: Instant Atmospheric Startup Canvas (Visible immediately on frame 1) -->
        <Border x:Name="AtmosphereCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#181F2C" Offset="0.0" />
                    <GradientStop Color="#0F131C" Offset="0.5" />
                    <GradientStop Color="#06080B" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Full-Screen Video Background with Smooth Frame 1 Fade-In -->
        <MediaElement x:Name="Player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      ScrubbingEnabled="True"
                      Stretch="UniformToFill"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Opacity="0"
                      MediaOpened="OnMediaOpened"
                      MediaEnded="OnMediaEnded"
                      MediaFailed="OnMediaFailed" />

        <!-- Fallback/Placeholder if video is not loaded or failed -->
        <Border x:Name="FallbackOverlay"
                Background="#111318"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="FallbackMessageText"
                           Text="No video loaded"
                           Foreground="#8AB4FF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Configure a video in Moonlit Settings."
                           Foreground="#A6ACB8"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
