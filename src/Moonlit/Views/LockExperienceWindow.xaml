<Window x:Class="Moonlit.Views.LockExperienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Moonlit.Views"
        Title="Moonlit Lock Experience"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Arrow"
        Focusable="True">

    <Grid Background="Black">
        <!-- Layer 1: Cinematic Video Background -->
        <views:VideoBackground x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 2: Live Clock & Date Overlay with Vignette & Dimming -->
        <views:ClockOverlay x:Name="ClockView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</Window>
