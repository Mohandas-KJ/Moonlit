<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Moonlit</RootNamespace>
    <AssemblyName>Moonlit</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Moonlit</Product>
    <Company>Moonlit Project</Company>
    <Description>Your screen. Your atmosphere. Native Windows Lock Screen Video Utility.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

</Project>
