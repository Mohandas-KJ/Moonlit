<Window x:Class="Moonlit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Moonlit.Views"
        Title="Moonlit — Your screen. Your atmosphere."
        Height="870" Width="940"
        MinHeight="720" MinWidth="800"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.ico">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Scroll Area -->
            <RowDefinition Height="*" />
            <!-- Footer Action Row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app-icon.ico" Width="30" Height="30" Margin="0,0,10,0" />
                        <TextBlock Text="Moonlit" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Your screen. Your atmosphere. Custom cinematic lock screen." Style="{StaticResource HeaderTaglineStyle}" Margin="40,2,0,0" />
                </StackPanel>

                <!-- Status Badge & Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadgeBorder"
                            CornerRadius="16"
                            Padding="12,5"
                            Margin="0,0,10,0"
                            Background="{StaticResource ErrorBgBrush}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicatorDot" Width="9" Height="9" Fill="{StaticResource ErrorBrush}" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="Not Ready"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnRefreshStatusClicked"
                            ToolTip="Re-evaluate configuration and system status" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>

                <!-- 0. AESTHETIC / PERSONAL CUSTOMIZATION DISCLAIMER -->
                <Border Background="#1C1814" BorderBrush="#664D1A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✨" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Personal Customization Notice" FontWeight="SemiBold" Foreground="#FAB005" FontSize="12" />
                            <TextBlock Text="Moonlit is crafted for users who want an awesome, aesthetic cinematic lock experience on their personal PC. It is not intended for enterprise, government, or high-security regulatory compliance environments."
                                       Foreground="#D4D9E2" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. STATUS CARD -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="DetailStatusDot" Width="10" Height="10" Fill="{StaticResource ErrorBrush}" Margin="0,4,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="StatusHeadingText"
                                       Text="Not Ready — Choose a video to continue"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0" />
                        </StackPanel>

                        <TextBlock x:Name="StatusExplanationText"
                                   Grid.Row="1"
                                   Text="Select an MP4 video to enable the cinematic lock screen experience."
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="18,0,0,4" />

                        <Border x:Name="CorrectiveActionBorder"
                                Grid.Row="2"
                                Background="#1A202C"
                                BorderBrush="#2D3748"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="18,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Guidance: " FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                <TextBlock x:Name="CorrectiveActionText"
                                           Text="Click 'Choose Video' below to select an MP4 file."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. VIDEO BACKGROUND CARD -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Cinematic Video Background" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Select a local MP4 video file to play full-screen behind the clock and date."
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12" />

                        <!-- Path & Buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#171A21" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                <TextBlock x:Name="SelectedFilePathText"
                                           Text="No video selected"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="1"
                                    x:Name="ChooseVideoButton"
                                    Content="Choose Video…"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnChooseVideoClicked"
                                    Margin="0,0,8,0" />

                            <Button Grid.Column="2"
                                    x:Name="PreviewToggleButton"
                                    Content="Play Preview"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnPreviewToggleClicked"
                                    IsEnabled="False" />
                        </Grid>

                        <!-- File Info -->
                        <StackPanel x:Name="FileInfoPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="File size: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="FileSizeText" Text="--" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,16,0" />
                            <TextBlock Text="Format: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="FileFormatText" Text="--" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        </StackPanel>

                        <!-- In-App Preview Container -->
                        <Border Background="#0C0E12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="220" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="PreviewPlayer"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              ScrubbingEnabled="True"
                                              MediaEnded="OnMediaEnded"
                                              MediaFailed="OnMediaFailed"
                                              Stretch="Uniform" />

                                <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="No video loaded for preview" Foreground="{StaticResource MutedTextBrush}" FontSize="13" HorizontalAlignment="Center" />
                                    <TextBlock Text="Choose a video above to test playback" Foreground="#505666" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. CUSTOM CLOCK & DATE CARD -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Custom Clock &amp; Date Display" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Moonlit dynamically renders an atmospheric clock and date layer over the video."
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12" />

                        <!-- Live Clock Mini-Preview -->
                        <Border Background="#0D1117" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="140" Margin="0,0,0,14" ClipToBounds="True">
                            <views:ClockOverlay x:Name="ClockPreviewOverlay" ShowDismissHint="False" />
                        </Border>

                        <!-- Customization Controls Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Option 1: 24-Hour Format -->
                            <CheckBox Grid.Column="0" Grid.Row="0"
                                      x:Name="Format24HourCheckBox"
                                      Content="Use 24-Hour Format (14:30 vs 2:30 PM)"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      Margin="0,0,0,12"
                                      Checked="OnClockOptionChanged"
                                      Unchecked="OnClockOptionChanged" />

                            <!-- Option 2: Show Seconds -->
                            <CheckBox Grid.Column="1" Grid.Row="0"
                                      x:Name="ShowSecondsCheckBox"
                                      Content="Show Seconds (:45)"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      Margin="0,0,0,12"
                                      Checked="OnClockOptionChanged"
                                      Unchecked="OnClockOptionChanged" />

                            <!-- Option 3: Clock Alignment -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,0">
                                <TextBlock Text="Clock Alignment:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox x:Name="AlignmentComboBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="OnAlignmentSelectionChanged">
                                    <ComboBoxItem Content="Center" IsSelected="True" />
                                    <ComboBoxItem Content="Bottom-Left" />
                                    <ComboBoxItem Content="Top-Left" />
                                    <ComboBoxItem Content="Bottom-Right" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Option 4: Video Dimming Slider -->
                            <StackPanel Grid.Column="1" Grid.Row="1">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Video Dimming (Readability):" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                    <TextBlock x:Name="DimmingValueText" Text="25%" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="DimmingSlider"
                                        Minimum="0" Maximum="70" Value="25"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnDimmingSliderValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. LOCK INTEGRATION & SHORTCUTS CARD -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Lock Screen Integration &amp; Shortcuts" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Configure Windows session integration, hotkeys, and lock behavior." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12" />

                        <!-- SYSTEM POLICIES & ELEVATED SETUP BOX -->
                        <Border Background="#12161F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Windows System Integration &amp; Policy Status" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,0,0,8" />
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Win + L Direct Routing (DisableLockWorkstation)" FontWeight="Medium" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Allows Win + L to launch Moonlit without being intercepted by the Windows kernel." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="WinLPolicyStatusLabel" Text="Not Configured" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Skip Clock Curtain / Instant Password Prompt (NoLockScreen)" FontWeight="Medium" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Dismissing Moonlit opens your PIN / Password prompt directly, eliminating the static Windows clock." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="NoLockScreenStatusLabel" Text="Not Configured" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Action Buttons Row -->
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="ConfigurePoliciesButton"
                                            Content="🚀 1-Click System Setup (Admin)"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="14,6"
                                            Margin="0,0,8,8"
                                            Click="OnConfigureAllPoliciesClicked"
                                            ToolTip="One-time administrator configuration to enable Win+L interception and bypass the Windows lock curtain." />

                                    <Button x:Name="RevertPoliciesButton"
                                            Content="🧹 1-Click Restore Windows Defaults (Clear Registry)"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="14,6"
                                            Margin="0,0,8,8"
                                            Click="OnRevertPoliciesClicked"
                                            Foreground="#FAB005"
                                            ToolTip="Completely removes all Moonlit registry policies and restores native Windows 11 lock screen curtain, widgets, and default hotkey handling." />

                                    <Button x:Name="CreateShortcutsButton"
                                            Content="Create Desktop &amp; Start Shortcuts"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Margin="0,0,8,8"
                                            Click="OnCreateShortcutsClicked"
                                            ToolTip="Creates 'Lock PC with Moonlit' shortcuts on your Desktop and in the Start Menu." />

                                    <Button x:Name="AutoLogonButton"
                                            Content="Configure Auto-Logon (netplwiz)"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Margin="0,0,0,8"
                                            Click="OnOpenAutoLogonClicked"
                                            ToolTip="Opens Windows Netplwiz so your PC boots straight into Moonlit's cinematic lock screen." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Preference 0: Moonlit Interactive PIN Sign-In (Mac-Style) -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Moonlit Interactive PIN Sign-In (Mac-Style)" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="On any keypress or click, the clock slides up, video blurs, and asks for PIN (Default: 1080). After 1 min of inactivity, it gently returns to clock and video playback." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                <TextBlock Text="Current Testing PIN: 1080" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="MoonlitPinScreenCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 1: Intercept Win + L / Hotkeys -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Global Lock Hotkey Hooks (Win + L, Ctrl + Alt + L, Win + Alt + L)" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Listens for global lock combinations to trigger Moonlit's full-screen cinematic interface." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                <TextBlock x:Name="WinLStatusText" Text="Hook active." Foreground="{StaticResource ReadyBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="InterceptWinLCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 2: Jump directly to Password Prompt -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Skip Windows Clock Screen (Jump to Password / PIN)" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Dismissing Moonlit immediately raises the Windows lock curtain to reveal your PIN / Password entry box." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="JumpToPasswordPromptCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 3: Start on Boot as Lock Screen -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Play on Lock Screen at Boot (Cinematic Startup)" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Plays Moonlit full-screen when Windows starts up. Touching any key or mouse seamlessly transitions to your genuine Windows PIN / Password prompt." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="StartOnBootCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 4: Launch at Windows Sign-in -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Launch at Windows Sign-in / Boot" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Registers Moonlit in Windows Startup to run in the background and respond to lock events." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                <TextBlock x:Name="StartupStatusHintText" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="StartupCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="False" Checked="OnStartupCheckboxToggled" Unchecked="OnStartupCheckboxToggled" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 5: Enable Lock Experience -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Cinematic Lock Experience" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Master switch for displaying Moonlit full-screen video background and custom clock." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="LockExperienceCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,10,10" />

                        <!-- Preference 6: Loop Video Continuously -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loop Video Continuously" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Seamlessly restarts the video when it reaches the end." Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="LoopCheckBox" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="OnPreferenceChanged" Unchecked="OnPreferenceChanged" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. SYSTEM DIAGNOSTICS (EXPANDER) -->
                <Expander Header="Environment Diagnostics &amp; Display Metrics"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          Background="{StaticResource PanelBackgroundBrush}"
                          Padding="14"
                          Margin="0,0,0,12">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="DiagnosticDetailsText"
                                   Text="Loading diagnostics…"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= FOOTER ACTIONS ================= -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterFeedbackText" Text="Settings saved." Foreground="{StaticResource ReadyBrush}" FontSize="12" Visibility="Collapsed" />
                </StackPanel>

                <!-- Test Lock Experience (Preview) -->
                <Button Grid.Column="1"
                        x:Name="TestLockExperienceButton"
                        Content="Test Lock Experience"
                        Style="{StaticResource AccentOutlineButtonStyle}"
                        Click="OnTestLockExperienceClicked"
                        Margin="0,0,10,0"
                        ToolTip="Displays the full-screen cinematic lock interface. Press any key to return." />

                <!-- Lock PC with Moonlit (Transitions to Windows Lock) -->
                <Button Grid.Column="2"
                        x:Name="LockPcButton"
                        Content="Lock PC with Moonlit"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnLockPcClicked"
                        Margin="0,0,10,0"
                        ToolTip="Displays the cinematic interface and locks workstation upon dismissal." />

                <!-- Save Settings -->
                <Button Grid.Column="3"
                        x:Name="SaveSettingsButton"
                        Content="Save Settings"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSaveSettingsClicked"
                        Padding="20,8" />

                <!-- Exit Moonlit -->
                <Button Grid.Column="4"
                        x:Name="ExitAppButton"
                        Content="Exit Moonlit"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnExitAppClicked"
                        Margin="10,0,0,0"
                        Foreground="{StaticResource ErrorBrush}"
                        ToolTip="Completely terminates Moonlit, closes background services, and removes the tray icon." />
            </Grid>
        </Border>

    </Grid>
</Window>
